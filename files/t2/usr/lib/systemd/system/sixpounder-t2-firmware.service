[Unit]
Description=Recover Apple T2 Wi-Fi and Bluetooth firmware
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/sixpounder-t2-firmware auto
TimeoutStartSec=45min
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Terminating Python still unwinds its mount/loop cleanup on a timeout.
KillSignal=SIGINT
