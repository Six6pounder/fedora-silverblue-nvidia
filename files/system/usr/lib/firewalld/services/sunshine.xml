<service>
  <short>Sunshine</short>
  <description>Sunshine game-stream host (Moonlight clients). HTTPS/HTTP/Web UI/RTSP control ports plus the video/control/audio/mic UDP streams.</description>
  <port protocol="tcp" port="47984"/> <!-- HTTPS -->
  <port protocol="tcp" port="47989"/> <!-- HTTP -->
  <port protocol="tcp" port="47990"/> <!-- Web UI -->
